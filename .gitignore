# macOS
.DS_Store
*.swp

# Build
build/
.build/
dist/
target/
DerivedData/
*.xcuserstate
xcuserdata/

# Deps
node_modules/
.venv/
__pycache__/

# Secrets
.env
.env.*
!.env.example

# Model weights and generated video (large binaries)
models/
*.mp4
*.mov
*.safetensors
*.gguf

# Keyframe stills DO belong in the repo — they are the source of truth for
# regenerating any clip, and they are small. Only the rendered video is excluded.
!assets/akari/keyframes/*.png

# Brand assets ship with the code: they are one-off, not regenerable, and a
# checkout without them builds an app whose features have nothing to point at.
!assets/brand/*.png
!assets/brand/*.icns

# The wallpaper is the same kind of asset as the icon, so it ships too — but as
# HEIC, which is 0.9MB against the PNG's 15.3MB at PSNR 46dB (visually lossless,
# and smaller than AppIcon.icns). The PNG master stays out; regenerate other
# sizes from the HEIC, or from Magnific using the prompt in assets/brand/README.md.
#
# NOTE: do NOT write `assets/brand/wallpaper/` here to exclude the PNGs. Excluding
# a DIRECTORY makes every `!` rule for files inside it dead — git does not descend
# into an excluded directory, so the negation never gets a chance to match, and it
# fails silently. Exclude the extension, not the directory.
assets/brand/wallpaper/*.png
!assets/brand/wallpaper/*.heic
