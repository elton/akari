# akari 环境变量示例
#
# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除。凭据不要提交，也不要打印到日志或错误消息里。
#
# 本文件只有键名与说明，不含任何真实凭据。
# 下面出现的模型名与端点取自 docs/spec.md（公开信息），可按需覆盖。

# ---------------------------------------------------------------------------
# 阿里云百炼 DashScope —— 国际站 (Model Studio)
# ---------------------------------------------------------------------------

# 必填。控制台 → API-KEY 获取，形如 sk-xxxxxxxx
DASHSCOPE_API_KEY=

# OpenAI 兼容模式的 HTTP base URL（文本/视觉走这里）
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# DashScope 原生 HTTP API 的 base（非 OpenAI 兼容模式）
DASHSCOPE_NATIVE_ENDPOINT=https://dashscope-intl.aliyuncs.com/api/v1

# Realtime WebSocket 端点。实际连接时拼上 ?model=$QWEN_REALTIME_MODEL
# 鉴权头：Authorization: Bearer $DASHSCOPE_API_KEY
DASHSCOPE_REALTIME_ENDPOINT=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime

# ---------------------------------------------------------------------------
# 模型（ADR-003 / ADR-004）
# ---------------------------------------------------------------------------

# 主力对话 / 工具调用 / 看截图。原生支持图像输入，不需要单独的 VL 模型
QWEN_CHAT_MODEL=qwen3.7-flash

# 保留键：与 QWEN_CHAT_MODEL 填同一个值即可
QWEN_VL_MODEL=qwen3.7-flash

# 语音端到端。实测首个音频包中位 473ms
QWEN_REALTIME_MODEL=qwen3.5-omni-flash-realtime

# 复杂任务升级用（可选）
# QWEN_PLUS_MODEL=qwen3.7-plus

# ---------------------------------------------------------------------------
# 本地推理（可选，切到隐私模式时使用）
# ---------------------------------------------------------------------------

# MLX 权重。6-bit 约 22.8GB，64GB 机器上仍余约 40GB
LOCAL_MLX_MODEL=orcarouter/Qwen3.8-27B-Uncensored-MLX
LOCAL_MLX_QUANT=6bit

# 该 repo 是 gated，需先在 HuggingFace 申请访问权限再填 token
# HF_TOKEN=

# ---------------------------------------------------------------------------
# Cloudflare —— 备选推理路径（可选，不填则不启用）
# ---------------------------------------------------------------------------

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# CF_AI_CHAT_MODEL=
# CF_AI_ASR_MODEL=

# ---------------------------------------------------------------------------
# 运行时（可选）
# ---------------------------------------------------------------------------

# Unix socket 路径。两侧都读这个变量，留空则用
# ~/Library/Application Support/akari/core.sock
# AKARI_SOCKET=

# 形象素材目录，默认 <repo>/assets/akari
# AKARI_ASSETS_DIR=

# 日志级别：debug | info | warn | error
# AKARI_LOG_LEVEL=info
